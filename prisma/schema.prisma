generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════
//  ENUMS
// ════════════════════════════════════════════════════════════

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Semester {
  S1
  S2
}

enum ClassStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  FAILED
}

enum CourseTeacherRole {
  MAIN_TEACHER
  ASSISTANT
  GUEST
}

enum EvaluationType {
  CC
  TP
  EXAM
  PROJECT
}

// ════════════════════════════════════════════════════════════
//  ORGANISATION ACADÉMIQUE
// ════════════════════════════════════════════════════════════

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  programs Program[]

  @@map("departments")
}

model Program {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  name         String
  code         String?  @unique
  createdAt    DateTime @default(now()) @map("created_at")

  department Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  levels     ProgramLevel[]

  @@index([departmentId])
  @@map("programs")
}

model ProgramLevel {
  id         String @id @default(uuid())
  programId  String @map("program_id")
  levelName  String @map("level_name")
  levelOrder Int    @map("level_order")

  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  curriculumCourses CurriculumCourse[]
  classGroups       ClassGroup[]

  @@unique([programId, levelName])
  @@index([programId])
  @@map("program_levels")
}

// ════════════════════════════════════════════════════════════
//  CATALOGUE PÉDAGOGIQUE
// ════════════════════════════════════════════════════════════

model CurriculumCourse {
  id             String   @id @default(uuid())
  programLevelId String   @map("program_level_id")
  name           String
  code           String?  @unique
  semester       Semester
  credits        Int
  coefficient    Decimal  @default(1.0) @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  programLevel ProgramLevel     @relation(fields: [programLevelId], references: [id], onDelete: Cascade)
  instances    CourseInstance[]

  @@index([programLevelId])
  @@index([semester])
  @@map("curriculum_courses")
}

// ════════════════════════════════════════════════════════════
//  STRUCTURE ANNUELLE
// ════════════════════════════════════════════════════════════

model ClassGroup {
  id             String      @id @default(uuid())
  programLevelId String      @map("program_level_id")
  name           String
  academicYear   String      @map("academic_year")
  status         ClassStatus @default(DRAFT)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  programLevel    ProgramLevel     @relation(fields: [programLevelId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  courseInstances CourseInstance[]

  @@unique([programLevelId, name, academicYear])
  @@index([programLevelId])
  @@index([academicYear])
  @@map("class_groups")
}

model CourseInstance {
  id                 String   @id @default(uuid())
  curriculumCourseId String   @map("curriculum_course_id")
  classGroupId       String   @map("class_group_id")
  academicYear       String   @map("academic_year")
  contentRef         String?  @map("content_ref") // → MongoDB course_content._id
  createdAt          DateTime @default(now()) @map("created_at")

  curriculumCourse CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  classGroup       ClassGroup       @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teachers         CourseTeacher[]
  evaluations      Evaluation[]

  @@unique([curriculumCourseId, classGroupId, academicYear])
  @@index([classGroupId])
  @@index([academicYear])
  @@map("course_instances")
}

model CourseTeacher {
  id               String            @id @default(uuid())
  courseInstanceId String            @map("course_instance_id")
  teacherId        String            @map("teacher_id")
  role             CourseTeacherRole @default(MAIN_TEACHER)
  assignedAt       DateTime          @default(now()) @map("assigned_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseInstanceId, teacherId])
  @@index([teacherId])
  @@map("course_teachers")
}

// ════════════════════════════════════════════════════════════
//  UTILISATEURS & SÉCURITÉ
// ════════════════════════════════════════════════════════════

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  ldapUid      String?    @unique @map("ldap_uid")
  role         Role       @default(STUDENT)
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  sessions       Session[]
  enrollments    Enrollment[]
  courseTeaching CourseTeacher[]
  gradesGiven    Grade[]         @relation("GradedBy")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ════════════════════════════════════════════════════════════
//  INSCRIPTIONS
// ════════════════════════════════════════════════════════════

model Enrollment {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  classGroupId         String           @map("class_group_id")
  academicYear         String           @map("academic_year")
  status               EnrollmentStatus @default(ACTIVE)
  enrolledAt           DateTime         @default(now()) @map("enrolled_at")
  previousEnrollmentId String?          @map("previous_enrollment_id")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup    @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  grades       Grade[]
  certificates Certificate[]

  previousEnrollment Enrollment?  @relation("EnrollmentHistory", fields: [previousEnrollmentId], references: [id])
  nextEnrollments    Enrollment[] @relation("EnrollmentHistory")

  @@unique([userId, academicYear])
  @@index([classGroupId])
  @@index([academicYear])
  @@map("enrollments")
}

// ════════════════════════════════════════════════════════════
//  ÉVALUATIONS & NOTES
// ════════════════════════════════════════════════════════════

model Evaluation {
  id               String         @id @default(uuid())
  courseInstanceId String         @map("course_instance_id")
  type             EvaluationType
  name             String
  weight           Decimal        @db.Decimal(3, 2)
  maxScore         Decimal        @default(20.0) @map("max_score") @db.Decimal(5, 2)
  quizRef          String?        @map("quiz_ref") // → MongoDB quizzes._id
  scheduledAt      DateTime?      @map("scheduled_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  grades         Grade[]

  @@index([courseInstanceId])
  @@map("evaluations")
}

model Grade {
  id           String   @id @default(uuid())
  enrollmentId String   @map("enrollment_id")
  evaluationId String   @map("evaluation_id")
  score        Decimal  @db.Decimal(5, 2)
  gradedBy     String?  @map("graded_by")
  gradedAt     DateTime @default(now()) @map("graded_at")
  comment      String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  grader     User?      @relation("GradedBy", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, evaluationId])
  @@index([enrollmentId])
  @@index([evaluationId])
  @@map("grades")
}

model Certificate {
  id           String   @id @default(uuid())
  enrollmentId String   @map("enrollment_id")
  s3Path       String   @map("s3_path")
  verifyToken  String   @unique @default(uuid()) @map("verify_token")
  issuedAt     DateTime @default(now()) @map("issued_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("certificates")
}

// ════════════════════════════════════════════════════════════
//  AUDIT
// ════════════════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  actorEmail   String?  @map("actor_email")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
